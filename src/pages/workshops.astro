---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import StickyCTA from '../components/StickyCTA.astro';
import ToolLogos from '../components/ToolLogos.astro';
import UseCaseLadder from '../components/UseCaseLadder.astro';
import SocialProof from '../components/SocialProof.astro';
import MentorCard from '../components/MentorCard.astro';
import LadderCard from '../components/LadderCard.astro';
import NextSession from '../components/islands/NextSession.tsx';
import { workshops, nextWorkshopSession, formatIST, WORKSHOP_TIME } from '../data/workshops';
import type { LadderStep } from '../data/workshops';
import { ladder } from '../data/ladder';
import { mentorFor } from '../data/mentors';
import type { FAQItem } from '../data/types';

const nextSession = formatIST(nextWorkshopSession());
const registerHref = workshops[0].href;
const mentor = mentorFor('default');

/** Rungs 1-3. The workshop is complete on its own; this is only what is above it. */
const nextRungs = ladder.filter((r) => [1, 2, 3].includes(r.rung));

/**
 * The default page is tool-agnostic, so the ladder is written for a coder's
 * day rather than for one product. Steps 1-3 run in the session, 4 is a
 * teaser, 5 is never described.
 */
const steps: LadderStep[] = [
  {
    n: 1,
    title: 'Turn a ticket into a plan',
    blurb: 'You bring one real task from your week. It comes back as a plan you can argue with before any code moves.',
  },
  {
    n: 2,
    title: 'Change code in a real repo',
    blurb: 'Your own repository, your own branch. The agent makes the change and you read every line of it.',
  },
  {
    n: 3,
    title: 'Tests and review, in the loop',
    blurb: 'It writes the test, runs it, and fixes what fails. You decide what actually ships.',
  },
  {
    n: 4,
    title: 'Refactor across the repo',
    blurb: 'A change that touches twenty files, done in one pass. We run it live.',
    teaser: true,
  },
  { n: 5, title: 'Surprise', blurb: '', hidden: true },
];

const faq: FAQItem[] = [
  {
    q: 'Is it really free?',
    a: 'Yes. Ninety minutes, live, nothing to pay. There is a paid ladder above it and you will hear that it exists.',
  },
  {
    q: 'How often does it run?',
    a: 'Every other day at 7:00 PM IST, live. The date at the top of this page is the next session; if it does not fit, take the one after it.',
  },
  {
    q: 'Which tool do I pick?',
    a: 'The one you already have open. You choose it when you book — about ninety per cent of the session is the same either way.',
  },
  {
    q: 'I do not write code. Is this for me?',
    a: 'Yes. The ChatGPT, AI for PMs, and AI for Founders flavours run entirely in a browser. Nothing to install, no terminal.',
  },
  {
    q: 'What do I need before the session?',
    a: 'A laptop, an account in the tool, and one real task of your own. Setup is not part of the 90 minutes, so do the account bit beforehand.',
  },
  {
    q: 'Is there a recording?',
    a: 'Yes, sent afterwards. You build during the session though — watching later is not the same session.',
  },
  {
    q: 'Where does the registration link go?',
    a: 'To outskill.com, where the seat is booked. Per-workshop links are not live yet, so they all point at the same place for now.',
  },
];
---

<Base
  title="90 min Workshop — free, live AI productivity for engineers and PMs"
  description="Unlock AI productivity for coders, SWEs, QA, SDEs, DevOps, data folks and PMs. Ninety minutes, live, free — in ChatGPT, Codex, Claude Code or GitHub Copilot."
  image="/gen/v2/workshop.webp"
  cta={{ label: 'Reserve a seat', href: registerHref }}
>
  <!-- ==================== HERO ==================== -->
  <section class="hero grain relative isolate overflow-hidden border-b border-line">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap relative z-10 pt-12 pb-10 md:pt-24 md:pb-20">
      <div class="max-w-[36rem] lg:max-w-[44rem]">
        <p class="eyebrow">90 min Workshop · Free · Live</p>

        <!--
          The audience list is set as type, not as a paragraph: a second
          display line. Both lines are display classes (>= 1.75rem), which is
          the only place tracking is allowed to exist.
        -->
        <h1 class="mt-3">
          <span class="display-xl block">Unlock AI productivity for</span>
          <span class="display-md mt-2 block text-muted"
            >coders, SWEs, QA, SDEs, DevOps, data folks and PMs.</span
          >
        </h1>

        <p class="mt-4 max-w-[30rem] text-[1.0625rem] text-muted md:text-[1.25rem]">
          You build one working thing before the 90 minutes are up.
        </p>

        <!-- Duration / When / Format / Price. "When" is an island because the
             page is prerendered and a build-time date goes stale in days. -->
        <div class="mt-7 md:hidden">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-[0.8125rem] text-muted">Duration</dt>
              <dd class="mt-0.5 text-[0.9375rem] font-semibold text-fg">90 minutes</dd>
            </div>
            <div class="col-span-2">
              <dt class="text-[0.8125rem] text-muted">When</dt>
              <dd class="mt-0.5 text-[0.9375rem]">
                <NextSession client:idle fallback={nextSession} time={WORKSHOP_TIME} />
              </dd>
            </div>
            <div>
              <dt class="text-[0.8125rem] text-muted">Format</dt>
              <dd class="mt-0.5 text-[0.9375rem] font-semibold text-fg">Live online</dd>
            </div>
            <div>
              <dt class="text-[0.8125rem] text-muted">Price</dt>
              <dd class="mt-0.5 text-[0.9375rem] font-semibold text-fg">Free</dd>
            </div>
          </dl>
          <a href={registerHref} class="btn btn-accent btn-block mt-5">Reserve a seat</a>
          <a href="#pick" class="btn btn-ghost btn-block mt-2.5">Pick your tool</a>
        </div>

        <div class="mt-9 hidden items-center gap-6 md:flex">
          <a href={registerHref} class="btn btn-accent shrink-0">Reserve a seat</a>
          <dl class="flex flex-wrap gap-x-8 gap-y-4 border-l border-line-strong pl-5">
            <div>
              <dt class="text-[0.8125rem] text-muted">Duration</dt>
              <dd class="mt-0.5 text-[0.9375rem] font-semibold text-fg">90 minutes</dd>
            </div>
            <div>
              <dt class="text-[0.8125rem] text-muted">When</dt>
              <dd class="mt-0.5 text-[0.9375rem]">
                <NextSession client:idle fallback={nextSession} time={WORKSHOP_TIME} />
              </dd>
            </div>
            <div>
              <dt class="text-[0.8125rem] text-muted">Format</dt>
              <dd class="mt-0.5 text-[0.9375rem] font-semibold text-fg">Live online</dd>
            </div>
            <div>
              <dt class="text-[0.8125rem] text-muted">Price</dt>
              <dd class="mt-0.5 text-[0.9375rem] font-semibold text-fg">Free</dd>
            </div>
          </dl>
        </div>

        <a
          href="#pick"
          class="mt-5 hidden text-[0.9375rem] text-muted underline-offset-4 hover:text-fg hover:underline md:inline-block"
        >
          Pick your tool →
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== PICK YOUR TOOL ==================== -->
  <Section
    id="pick"
    class="scroll-mt-16"
    eyebrow="Pick your tool"
    title="Same 90 minutes, in the tool you already have open."
    lead="You choose the flavour when you book — there is one session and one seat to reserve."
  >
    <ToolLogos label="Tools the 90 min Workshop runs in" />

    <div class="mt-8 flex flex-col gap-4 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-[0.9375rem] text-muted">
        Bring a laptop, an account in the tool, and one real task of your own.
      </p>
      <a href={registerHref} class="btn btn-accent w-full shrink-0 sm:w-auto">Reserve a seat</a>
    </div>
  </Section>

  <!-- ==================== USE CASE LADDER ==================== -->
  <Section
    rule
    id="ladder"
    class="scroll-mt-16"
    eyebrow="A coder's day"
    title="Things you can start using today."
    lead="Five steps through the work you already do, the first three of them live in the session."
  >
    <UseCaseLadder steps={steps} />
  </Section>

  <!-- ==================== SOCIAL PROOF ==================== -->
  <Section rule eyebrow="Who has done this" title="People who came out the other side.">
    <SocialProof />
  </Section>

  <!-- ==================== MENTOR ==================== -->
  <Section rule eyebrow="Who runs it" title="One person, live, for 90 minutes.">
    <MentorCard mentor={mentor} />
  </Section>

  <!-- ==================== NEXT RUNGS ==================== -->
  <Section
    rule
    id="more"
    eyebrow="After the 90 minutes"
    title="Looking for something more serious?"
    lead="The workshop is complete on its own; this is the order it goes in if you want more."
  >
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-5">
      {nextRungs.map((r) => <LadderCard rung={r} featured={r.cta.kind === 'free'} />)}
    </div>
  </Section>

  <!-- ==================== FAQ ==================== -->
  <Section rule eyebrow="Before you book" title="Straight answers.">
    <FAQ items={faq} />
  </Section>

  <Newsletter />

  <StickyCTA label="90 min Workshop" price="Free" ctaLabel="Reserve a seat" ctaHref={registerHref} kind="free" />
</Base>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  /* v2 art first, V1 hero underneath as a fallback: a layer that 404s is
     transparent, so the next one shows through. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/gen/v2/workshop-m.webp'), url('/gen/v2/workshop.webp'), url('/gen/hero-hub.webp');
    background-position: 55% 40%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .hero-art {
      background-image: url('/gen/v2/workshop.webp'), url('/gen/hero-hub.webp');
      background-position: right center;
    }
  }

  /* The art is dark-left with a lit subject right; the scrim keeps the
     headline and the info blocks above AA on both crops. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.94) 0%, rgba(10, 10, 10, 0.78) 48%, rgba(10, 10, 10, 0.45) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.3) 0%, rgba(10, 10, 10, 0.55) 45%, rgba(10, 10, 10, 0.88) 80%, var(--color-bg) 100%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(10, 10, 10, 0.92) 40%, rgba(10, 10, 10, 0.25) 70%, rgba(10, 10, 10, 0) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.3) 0%, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.5) 100%);
    }
  }
</style>

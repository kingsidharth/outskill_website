---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import LadderCard from '../components/LadderCard.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import StickyCTA from '../components/StickyCTA.astro';
import InfoBlocks from '../components/InfoBlocks.astro';
import AgentLoopExplorer from '../components/islands/AgentLoopExplorer';
import { bootcamp } from '../data/bootcamp';
import { ladderBySlug } from '../data/ladder';
import type { InfoBlock } from '../data/types';

const before = ladderBySlug['mastermind'];
const after = ladderBySlug['accelerator'];

const info: InfoBlock[] = [
  { label: 'Duration', value: '14 days' },
  { label: 'Format', value: 'Live sprints, evenings' },
  { label: 'Next start', value: 'At enrolment' },
  { label: 'Price', value: '₹2,499' },
];

/* Three outcome cards. Metrics are programme facts drawn from the sprint list
   below — nothing here is invented. */
const outcomeCards = [
  {
    metric: '1 agent',
    title: 'That opens a pull request',
    body: 'By day fourteen your agent plans a scoped task, edits a real repository, runs the tests, and puts up a PR for you to review.',
  },
  {
    metric: '8 sprints',
    title: 'Each ending in something runnable',
    body: 'One system layer per sprint — loop, tools, memory, sandbox, evals, orchestration, operations, capstone. Nothing is left as a diagram.',
  },
  {
    metric: 'Your repo',
    title: 'Reviewed, and yours to keep',
    body: 'The work happens in your own repository, gets code review, and stays in your portfolio after the cohort ends.',
  },
];
---

<Base
  title={bootcamp.seo.title}
  description={bootcamp.seo.description}
  image="/gen/v2/bootcamp.webp"
  cta={{ label: 'Enrol', href: '#register' }}
>
  <!-- ==================== HERO ==================== -->
  <section class="hero grain relative isolate overflow-hidden border-b border-line">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap relative z-10 pt-12 pb-10 md:pt-24 md:pb-20">
      <div class="max-w-[36rem] lg:max-w-[42rem]">
        <p class="eyebrow">{bootcamp.eyebrow}</p>
        <h1 class="display-xl mt-3">{bootcamp.headline}</h1>
        <p class="mt-4 max-w-[30rem] text-[1.0625rem] text-muted md:text-[1.25rem]">{bootcamp.subhead}</p>

        <div class="mt-7 md:hidden">
          <InfoBlocks items={info} />
          <a href="#register" class="btn btn-accent btn-block mt-5">Enrol</a>
          <a href="#sprints" class="btn btn-ghost btn-block mt-2.5">See the 14 days</a>
        </div>

        <div class="mt-9 hidden items-center gap-6 md:flex">
          <a href="#register" class="btn btn-accent shrink-0">Enrol</a>
          <InfoBlocks items={info} variant="row" />
        </div>

        <p class="mt-5 hidden text-[0.9375rem] text-muted md:block">
          <span class="text-faint line-through">₹19,999</span>
          <span class="ml-2">₹2,499 — intro price for this cohort.</span>
          <a href="#sprints" class="ml-2 underline-offset-4 hover:text-fg hover:underline">See the 14 days →</a>
        </p>

        <dl class="mt-10 flex gap-6 border-t border-line pt-6 md:mt-12 md:gap-10">
          {
            [
              { value: '14', label: 'Days, evenings' },
              { value: '8', label: 'Sprints, each ships' },
              { value: '1', label: 'Coding agent, yours' },
            ].map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display block text-[1.75rem] font-bold leading-none md:text-[2.125rem]">{s.value}</span>
                  <span class="mt-0.5 block text-[0.8125rem] text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================== OUTCOMES ==================== -->
  <Section
    eyebrow="What you leave with"
    title="Fourteen days later, something of yours is running."
    lead="Not notes on agent architecture. An agent you can start, hand a ticket, and watch work."
  >
    <div class="grid gap-4 md:grid-cols-3 md:gap-5">
      {
        outcomeCards.map((o) => (
          <article class="card flex flex-col p-5 md:p-7">
            <p class="num text-[2rem] text-accent">{o.metric}</p>
            <h3 class="heading-sm mt-2">{o.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{o.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== AGENT LOOP ISLAND ==================== -->
  <Section
    rule
    id="loop"
    eyebrow="The thing you are building"
    title="The loop your agent runs on every task."
    lead="Click a stage to see what it has to get right — and what the agent is carrying while it works."
  >
    <AgentLoopExplorer client:visible />
  </Section>

  <!-- ==================== SPRINTS ==================== -->
  <Section
    rule
    id="sprints"
    eyebrow="The 14 days"
    title="One system layer per sprint."
    lead="Each sprint ends with something runnable, so the finished agent has a history you can explain line by line."
  >
    <ol class="border-t border-line">
      {
        bootcamp.sprints?.map((s) => (
          <li class="grid gap-4 border-b border-line py-6 md:grid-cols-[11rem_1fr] md:gap-10 md:py-8">
            <div>
              <p class="label label-accent">{s.days}</p>
              <p class="label mt-1">Sprint {s.n}</p>
            </div>
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="heading-sm">{s.title}</h3>
                <p class="label">{s.focus}</p>
              </div>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.learn.map((item) => (
                  <li class="rounded-md border border-line px-2.5 py-1 text-[0.8125rem] text-muted">{item}</li>
                ))}
              </ul>
              <p class="mt-4 text-[0.9375rem] md:text-base">
                <span class="font-semibold text-accent">You ship: </span>
                {s.ship}
              </p>
              <p class="mt-1.5 text-[0.8125rem] text-faint">Tools: {s.tools.join(' · ')}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ==================== BUILT LAYERS + AUDIENCE ==================== -->
  <Section
    rule
    eyebrow="Who it's for"
    title="Engineers who would rather build the tool than wait for it."
    lead="You need programming experience and a repository you care about. No machine learning background is assumed."
  >
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <p class="label">You will be able to</p>
        <ul class="mt-4 space-y-3">
          {
            bootcamp.outcomes.map((o) => (
              <li class="flex items-start gap-3 text-[0.9375rem] md:text-base">
                <svg viewBox="0 0 16 16" class="mt-1 size-4 shrink-0 text-accent" fill="none" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {o}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="label">This fits you if</p>
        <ul class="mt-4 space-y-3">
          {bootcamp.audience.map((a) => <li class="card px-5 py-4 text-[0.9375rem]">{a}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- ==================== ADJACENT RUNGS ==================== -->
  <Section
    rule
    eyebrow="Not sure this is the right step"
    title="The step below is free. The step above is fourteen full days."
    lead="Trade down if you want to test the water first, or up if you can clear two weeks and want production practice."
  >
    <div class="grid gap-4 md:grid-cols-2 md:gap-5">
      <LadderCard rung={before} featured />
      <LadderCard rung={after} />
    </div>
  </Section>

  <!-- ==================== FAQ ==================== -->
  <Section rule eyebrow="Before you enrol" title="Straight answers.">
    <FAQ items={bootcamp.faq} />
  </Section>

  <!-- ==================== ENROL ==================== -->
  <Section
    rule
    id="register"
    eyebrow="Enrol"
    title="Take the seat."
    lead="Leave your email and we'll send the schedule, the prerequisites, and the payment link for this cohort."
  >
    <div class="card max-w-2xl p-5 md:p-7">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-5">
        <span class="text-[1rem] text-faint line-through">₹19,999</span>
        <span class="num text-[1.75rem] text-accent">₹2,499</span>
        <span class="text-[0.9375rem] text-muted">intro price for this cohort</span>
      </div>

      <form id="register-form" data-program={bootcamp.slug} class="mt-5 flex flex-col gap-3 sm:flex-row">
        <label for="register-email" class="sr-only">Email address</label>
        <input
          id="register-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          class="w-full flex-1 rounded-md border border-line bg-bg px-4 py-3 text-[1rem] text-fg placeholder:text-faint focus:border-accent focus:outline-none"
        />
        <button type="submit" class="btn btn-accent shrink-0">Enrol</button>
      </form>
      <p id="register-msg" role="status" class="mt-3 min-h-6 text-[0.9375rem] text-accent"></p>
      <p class="mt-1 text-[0.8125rem] text-muted">
        One email with the details. Nothing is charged from this form.
      </p>
    </div>
  </Section>

  <Newsletter />

  <StickyCTA
    label="14 days · Bootcamp"
    price="₹2,499"
    listPrice="₹19,999"
    ctaLabel="Enrol"
    ctaHref="#register"
  />
</Base>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/gen/v2/bootcamp-m.webp'), url('/gen/v2/bootcamp.webp'), url('/gen/hero-bootcamp.webp');
    background-position: 62% 38%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .hero-art {
      background-image: url('/gen/v2/bootcamp.webp'), url('/gen/hero-bootcamp.webp');
      background-position: right center;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.94) 0%, rgba(10, 10, 10, 0.78) 45%, rgba(10, 10, 10, 0.5) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.4) 0%, rgba(10, 10, 10, 0.6) 45%, rgba(10, 10, 10, 0.92) 78%, var(--color-bg) 100%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(10, 10, 10, 0.92) 38%, rgba(10, 10, 10, 0.25) 68%, rgba(10, 10, 10, 0) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.35) 0%, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 100%);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('register-form');
    if (!(form instanceof HTMLFormElement)) return;
    const msg = document.getElementById('register-msg');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, program: form.dataset.program }),
        });
        if (!res.ok) throw new Error('register failed');
        if (msg) msg.textContent = "You're in — check your inbox for the schedule and payment link.";
        form.reset();
      } catch {
        if (msg) msg.textContent = 'Something went wrong. Please try again.';
      }
    });
  });
</script>

---
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import CouponUnlock from '../../../components/islands/CouponUnlock';
import ShareBar from '../../../components/islands/ShareBar';
import { quiz } from '../../../data/quiz';
import { couponCode, formatCohortDate, nextCohortAfter, mastermind } from '../../../data/mastermind';

/** Five shareable pages, one per possible score. */
export function getStaticPaths() {
  return ['0', '1', '2', '3', '4'].map((score) => ({ params: { score } }));
}

const n = Number(Astro.params.score);
const total = quiz.length;
const perfect = n === total;

// Same stored-date-wins rule as /mastermind, so the two pages can never
// disagree about which weekend the coupon dies on.
const stored = mastermind.nextCohortStart ? new Date(mastermind.nextCohortStart) : null;
const start = stored && stored.getTime() > Date.now() ? stored : nextCohortAfter();
const cohortDate = formatCohortDate(start);

const verdict = perfect ? "You're ready for the Accelerator." : 'Score low? Join the Mastermind to find out why.';
const shareText = `I scored ${n}/4 on Outskill's AI knowledge check`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://outskill.com').href;
---

<Base
  title={`I scored ${n}/4 on Outskill's AI knowledge check`}
  description={`${shareText}. ${verdict} Four questions engineers get wrong about how LLMs actually work.`}
  cta={{ label: 'Weekend Mastermind', href: '/mastermind' }}
>
  <!-- ==================== SCORE ==================== -->
  <section class="border-b border-line">
    <div class="wrap pt-12 pb-10 md:pt-20 md:pb-16">
      <div class="max-w-[42rem]">
        <p class="eyebrow">Your result</p>
        <p class="display-xl mt-3">
          {n}<span class="text-faint">/{total}</span>
        </p>
        <p class="mt-4 max-w-[32rem] text-[1.0625rem] text-fg md:text-[1.25rem]">{verdict}</p>

        <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
          <a href="/mastermind#register" class="btn btn-accent btn-block sm:w-auto">Claim your free seat</a>
          {
            perfect && (
              <a href="/accelerator" class="btn btn-ghost btn-block sm:w-auto">
                Explore the Accelerator
              </a>
            )
          }
          <a href="/quiz" class="btn btn-ghost btn-block sm:w-auto">Take it again</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== COUPON ==================== -->
  <section aria-labelledby="coupon-heading" class="border-b border-line bg-bg-deep">
    <div class="wrap py-10 md:py-14">
      <div class="grid gap-6 md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] md:items-start md:gap-12">
        <div>
          <p class="label">Your coupon</p>
          <p id="coupon-heading" class="mt-2 flex flex-wrap items-baseline gap-3">
            <span class="text-[1.375rem] text-faint line-through">{mastermind.price.original}</span>
            <span class="display-md">Free with coupon</span>
          </p>
          <p class="mt-3 max-w-sm text-[0.9375rem] text-muted">
            Use it at registration. It expires when the weekend starts.
          </p>
        </div>

        <div class="card p-5 md:p-6">
          <CouponUnlock client:idle code={couponCode} validUntil={cohortDate} revealed />
          <p class="mt-4 border-t border-line pt-4 text-[0.8125rem] text-muted">
            Next cohort starts {cohortDate}, 7 PM IST.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== THE FOUR WHYS ==================== -->
  <Section
    eyebrow="The answers"
    title="The four answers, and why."
  >
    <ol class="border-t border-line">
      {
        quiz.map((q, i) => (
          <li class="grid gap-2 border-b border-line py-6 md:grid-cols-[3rem_1fr] md:gap-8 md:py-7">
            <p class="num text-[0.875rem] text-accent">Q{i + 1}</p>
            <div>
              <h3 class="heading-xs">{q.prompt}</h3>
              <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{q.why}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ==================== SHARE ==================== -->
  <Section rule eyebrow="Share" title="Pass it on." lead="The link carries your score and the coupon.">
    <ShareBar client:idle url={canonical} text={shareText} />
  </Section>
</Base>

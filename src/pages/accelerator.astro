---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Stat from '../components/Stat.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import StickyBar from '../components/StickyBar.astro';
import SprintTimeline from '../components/islands/SprintTimeline.tsx';
import { accelerator } from '../data/accelerator';
import type { Feature } from '../data/types';

const addons: Feature[] = [
  { title: 'Business foundations', body: 'Learn to frame AI work in business terms: scoping, stakeholder communication, and ROI.' },
  { title: 'Monetisation modules', body: 'Package and price AI products, from SaaS to services and everything in between.' },
  { title: 'Tool & workflow deep dives', body: 'Extra deep-dive sessions into specific tools, frameworks, and deployment patterns.' },
  { title: 'Weekly AI updates', body: 'Stay current with curated AI news, model releases, and emerging engineering patterns.' },
];
---

<Base
  title={accelerator.seo.title}
  description={accelerator.seo.description}
  image="/gen/hero-accelerator.webp"
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background: linear-gradient(180deg, rgba(10,10,10,0.3) 0%, var(--bg) 100%), url('/gen/hero-accelerator.webp') center/cover no-repeat"
      aria-hidden="true"
    />
    <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-32">
      <p class="eyebrow">{accelerator.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-6xl">{accelerator.headline}</h1>
      <p class="mt-4 max-w-xl text-base text-muted sm:text-lg">{accelerator.subhead}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={accelerator.ctaHref} class="btn-accent">{accelerator.ctaLabel}</a>
      </div>
      <div class="mt-8 flex flex-wrap gap-6 sm:gap-10">
        {accelerator.stats.map((s) => <Stat stat={s} />)}
      </div>
      <div class="mt-6">
        {accelerator.price.original && (
          <span class="mr-2 text-lg text-muted line-through">{accelerator.price.original}</span>
        )}
        <span class="text-3xl font-display text-accent">{accelerator.price.current}</span>
        {accelerator.price.note && <p class="mt-1 text-sm text-muted">{accelerator.price.note}</p>}
      </div>
    </div>
  </section>

  <!-- Sprint Timeline -->
  <Section
    eyebrow="The curriculum"
    title="7 sprints. 70+ hours. 7+ applications."
    lead="Each sprint ends with something you can ship and show."
  >
    <SprintTimeline client:visible sprints={accelerator.sprints} />
  </Section>

  <!-- Features -->
  <Section eyebrow="What you'll build" title="Full-spectrum AI engineering.">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {accelerator.features.map((f) => (
        <div class="card p-5 sm:p-6">
          <p class="text-lg font-medium">{f.title}</p>
          <p class="mt-2 text-sm text-muted">{f.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Beyond engineering add-ons -->
  <Section
    eyebrow="Beyond engineering"
    title="The work around the work."
    lead="Accelerator includes modules that turn technical skill into career leverage."
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {addons.map((a) => (
        <div class="card p-5 sm:p-6">
          <p class="text-lg font-medium">{a.title}</p>
          <p class="mt-2 text-sm text-muted">{a.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Audience -->
  <Section eyebrow="Who is this for" title="Built for engineers who ship.">
    <ul class="grid gap-3 sm:grid-cols-2">
      {accelerator.audience.map((item) => (
        <li class="card flex items-start gap-3 p-4 sm:p-5">
          <svg class="mt-0.5 size-5 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8.5L6.5 12 13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-sm sm:text-base">{item}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- FAQ -->
  <Section eyebrow="FAQ" title="Common questions.">
    <FAQ items={accelerator.faq} />
  </Section>

  <!-- CTA -->
  <CTA
    eyebrow="Join the Accelerator"
    title="Start building the full AI stack."
    body="70+ hours of engineering, 7+ applications, one year of updates."
    ctaLabel={accelerator.ctaLabel}
    ctaHref={accelerator.ctaHref}
  />

  <StickyBar program={accelerator} />
</Base>
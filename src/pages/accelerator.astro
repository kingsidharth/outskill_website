---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import InfoBlocks from '../components/InfoBlocks.astro';
import SkillsList from '../components/SkillsList.astro';
import StackBenefits from '../components/StackBenefits.astro';
import CommunityLine from '../components/CommunityLine.astro';
import PythonBasecamp from '../components/PythonBasecamp.astro';
import CoverDontCover from '../components/CoverDontCover.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import SolveFor from '../components/SolveFor.astro';
import WhatYouGet from '../components/WhatYouGet.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import StickyCTA from '../components/StickyCTA.astro';
import SprintTimeline from '../components/islands/SprintTimeline.tsx';
import StillUnsure from '../components/islands/StillUnsure.tsx';
import IsThisForMe from '../components/islands/IsThisForMe.tsx';
import { accelerator } from '../data/accelerator';
import type { InfoBlock } from '../data/types';

/* No amount here — the Pricing section is the only place it appears (§2). */
const info: InfoBlock[] = [
  { label: 'Duration', value: '14 days' },
  { label: 'Format', value: 'Daily, live' },
  { label: 'Next start', value: 'On selection' },
  { label: 'Price', value: 'By application' },
];
---

<Base
  title={accelerator.seo.title}
  description={accelerator.seo.description}
  image="/gen/v2/accelerator.webp"
  cta={{ label: 'Apply now', href: '#apply' }}
  ctaKind="apply"
>
  <!-- ==================== HERO ==================== -->
  <section class="hero grain relative isolate overflow-hidden border-b border-line">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap relative z-10 pt-12 pb-10 md:pt-24 md:pb-20">
      <div class="max-w-[36rem] lg:max-w-[42rem]">
        <p class="eyebrow">{accelerator.eyebrow}</p>
        <h1 class="display-xl mt-3">{accelerator.headline}</h1>
        <p class="mt-4 max-w-[30rem] text-[1.0625rem] text-muted md:text-[1.25rem]">{accelerator.subhead}</p>

        <div class="mt-7 md:hidden">
          <InfoBlocks items={info} />
          <a href="#apply" class="btn btn-ghost btn-block mt-5">Apply now</a>
          <a href="#curriculum" class="btn btn-ghost btn-block mt-2.5">See the fourteen days</a>
        </div>

        <div class="mt-9 hidden items-center gap-6 md:flex">
          <a href="#apply" class="btn btn-ghost shrink-0">Apply now</a>
          <InfoBlocks items={info} variant="row" />
        </div>

        <a href="#curriculum" class="mt-5 hidden text-[0.9375rem] text-muted underline-offset-4 hover:text-fg hover:underline md:inline-block">
          See the fourteen days →
        </a>

        <dl class="mt-10 flex gap-6 border-t border-line pt-6 md:mt-12 md:gap-10">
          {
            [
              { value: '14', label: 'Days, back-to-back' },
              { value: '70+', label: 'Hours of training' },
              { value: '7+', label: 'Applications built' },
            ].map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display block text-[1.75rem] font-bold leading-none md:text-[2.125rem]">{s.value}</span>
                  <span class="mt-0.5 block text-[0.8125rem] text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================== SKILLS ==================== -->
  <Section
    id="skills"
    eyebrow="What you learn to build"
    title="Six things you can build after."
    lead="Not topics. Things that run, that someone else can open and use."
  >
    <SkillsList items={accelerator.skills} />

    <div class="mt-6 grid gap-4 md:mt-8 md:grid-cols-2 md:gap-5">
      {
        [accelerator.hackathon, accelerator.network].map((c) => (
          <article class="card p-5 md:p-7">
            <h3 class="heading-sm">{c.title}</h3>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-muted">{c.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== THE FOURTEEN DAYS ==================== -->
  <Section
    rule
    id="curriculum"
    eyebrow="The fourteen days"
    title="Open a day to see what it asks."
    lead="Every block ends with something shippable. Tap one for the focus and what you walk out with."
  >
    <SprintTimeline client:visible sprints={accelerator.sprints} />
  </Section>

  <!-- ==================== THE STACK, AS BENEFITS ==================== -->
  <Section
    rule
    eyebrow="The stack"
    title="Five questions the stack answers."
    lead="Tools change every quarter. These questions do not."
  >
    <StackBenefits items={accelerator.stackBenefits} />
  </Section>

  <!-- ==================== COMMUNITY ==================== -->
  <Section rule eyebrow="Who's in the room" title="A senior room.">
    <CommunityLine figures={accelerator.community.figures} roles={accelerator.community.roles} />
  </Section>

  <!-- ==================== PYTHON BASECAMP ==================== -->
  <Section
    rule
    eyebrow="Before day one"
    title="Rusty Python? Not a problem."
    lead="Basecamp runs before the cohort. It is free and it is included either way."
  >
    <PythonBasecamp
      title={accelerator.pythonBasecamp.title}
      body={accelerator.pythonBasecamp.body}
      helpsIf={accelerator.pythonBasecamp.helpsIf}
    />
  </Section>

  <!-- ==================== COVER / DON'T COVER ==================== -->
  <Section
    rule
    eyebrow="Scope"
    title="What we cover. What we don't."
    lead="Fourteen days buys depth in one direction. Here is which one."
  >
    <CoverDontCover cover={accelerator.cover} dontCover={accelerator.dontCover} />
  </Section>

  <!-- ==================== STILL UNSURE? ==================== -->
  <Section
    rule
    id="still-unsure"
    eyebrow="Still unsure?"
    title="Six questions. Answer honestly."
    lead="If most of these make you curious, this is your room. If not, we will say so."
  >
    <StillUnsure
      client:visible
      prompts={accelerator.stillUnsure.prompts}
      roles={accelerator.stillUnsure.roles}
      rolesLine={accelerator.stillUnsure.rolesLine}
      applyHref="#apply"
      mastermindHref="/mastermind"
      workshopsHref="/workshops"
    />
  </Section>

  <!-- ==================== OPEN SOURCE + TOOLS ==================== -->
  <Section
    rule
    eyebrow="Open source & local models"
    title="Hosted is a choice, not a default."
  >
    <ToolsGrid tools={accelerator.tools} note={accelerator.openSourceLine} />
  </Section>

  <!-- ==================== HOW WE SOLVE FOR ==================== -->
  <Section
    rule
    eyebrow="How we solve for"
    title="The twelve problems in the way."
    lead="Each one gets worked through on something you are building, not on a slide."
  >
    <SolveFor items={accelerator.solveFor} />
  </Section>

  <!-- ==================== WHAT YOU GET ==================== -->
  <WhatYouGet items={accelerator.whatYouGet} />

  <!-- ==================== IS THIS FOR ME? ==================== -->
  <Section
    rule
    id="fit"
    eyebrow="Is this for me?"
    title="Tick what is true for you."
    lead="Nothing is sent anywhere. It only changes the line at the bottom."
  >
    <IsThisForMe
      client:visible
      statements={accelerator.isThisForMe}
      programLabel="the Accelerator"
      fitAt={4}
      fitCta={{ label: 'Apply now', href: '#apply' }}
      fallbackCta={{ label: 'See the Mastermind', href: '/mastermind' }}
      fallbackLabel="the Mastermind"
    />
  </Section>

  <!-- ==================== PRICING (the only amount on the page) ==================== -->
  <PricingSection
    pricing={accelerator.pricing}
    programLabel="14 days Accelerator"
    title="One number. Applications reviewed in 48 hours."
  />

  <!-- ==================== APPLY ==================== -->
  <Section
    rule
    id="apply"
    eyebrow="Apply"
    title="Start your application."
    lead="Leave your email. We come back within 48 hours with fit, dates and next steps."
  >
    <div class="card max-w-2xl p-5 md:p-7">
      <form id="register-form" data-program={accelerator.slug} class="flex flex-col gap-3 sm:flex-row">
        <label for="register-email" class="sr-only">Email address</label>
        <input
          id="register-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          class="w-full flex-1 rounded-md border border-line bg-bg px-4 py-3 text-[1rem] text-fg placeholder:text-faint focus:border-accent focus:outline-none"
        />
        <button type="submit" class="btn btn-ghost shrink-0">Apply now</button>
      </form>
      <p id="register-msg" role="status" class="mt-3 min-h-6 text-[0.9375rem] text-accent"></p>
      <p class="mt-1 text-[0.8125rem] text-muted">Nothing is charged from this form.</p>
    </div>
  </Section>

  <!-- ==================== FAQ ==================== -->
  <Section rule eyebrow="Before you apply" title="Straight answers.">
    <FAQ items={accelerator.faq} />
  </Section>

  <Newsletter />

  <StickyCTA
    kind="apply"
    label="14 days Accelerator"
    note="By application"
    ctaLabel="Apply now"
    ctaHref="#apply"
  />
</Base>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/gen/v2/accelerator-m.webp'), url('/gen/v2/accelerator.webp'), url('/gen/hero-accelerator.webp');
    background-position: 62% 38%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .hero-art {
      background-image: url('/gen/v2/accelerator.webp'), url('/gen/hero-accelerator.webp');
      background-position: right center;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.94) 0%, rgba(10, 10, 10, 0.78) 45%, rgba(10, 10, 10, 0.5) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.4) 0%, rgba(10, 10, 10, 0.6) 45%, rgba(10, 10, 10, 0.92) 78%, var(--color-bg) 100%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(10, 10, 10, 0.92) 38%, rgba(10, 10, 10, 0.25) 68%, rgba(10, 10, 10, 0) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.35) 0%, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 100%);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('register-form');
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.bound) return;
    form.dataset.bound = '1';
    const msg = document.getElementById('register-msg');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, program: 'accelerator' }),
        });
        if (!res.ok) throw new Error('register failed');
        if (msg) msg.textContent = "Application started — we'll come back within 48 hours.";
        form.reset();
      } catch {
        if (msg) msg.textContent = 'Something went wrong. Please try again.';
      }
    });
  });
</script>

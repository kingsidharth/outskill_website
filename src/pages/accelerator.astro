---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import LadderCard from '../components/LadderCard.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import StickyCTA from '../components/StickyCTA.astro';
import InfoBlocks from '../components/InfoBlocks.astro';
import SprintTimeline from '../components/islands/SprintTimeline.tsx';
import { accelerator } from '../data/accelerator';
import { ladderBySlug } from '../data/ladder';
import type { Feature, InfoBlock } from '../data/types';

const before = ladderBySlug['bootcamp'];
const after = ladderBySlug['fellowship'];

const info: InfoBlock[] = [
  { label: 'Duration', value: '14 days' },
  { label: 'Format', value: 'Daily, back-to-back' },
  { label: 'Next start', value: 'On selection' },
  { label: 'Price', value: '₹1,25,000' },
];

const addons: Feature[] = [
  { title: 'Business foundations', body: 'Frame AI work in business terms: scoping, stakeholder communication, and what it returns.' },
  { title: 'Monetisation modules', body: 'Package and price what you build, from software to services.' },
  { title: 'Tool and workflow deep dives', body: 'Extra sessions on specific tools, frameworks, and deployment patterns.' },
  { title: 'Weekly AI updates', body: 'A year of curated releases and the engineering patterns that come with them.' },
];

/* Metrics are programme facts from accelerator.ts — nothing invented. */
const outcomeCards = [
  {
    metric: '7+ apps',
    title: 'Built end to end',
    body: 'Chat systems, an automation pipeline, a RAG assistant grounded in your own media, agents, and a multi-agent development team.',
  },
  {
    metric: '1 system',
    title: 'Past the demo line',
    body: 'The capstone gets deployed with evals, cost controls, security, and monitoring — the parts that decide whether it survives a week.',
  },
  {
    metric: '1 year',
    title: 'Of live updates',
    body: 'The field moves. You keep getting the model releases and pattern changes that matter for what you built.',
  },
];
---

<Base
  title={accelerator.seo.title}
  description={accelerator.seo.description}
  image="/gen/v2/accelerator.webp"
  cta={{ label: 'Apply now', href: '#apply' }}
  ctaKind="apply"
>
  <!-- ==================== HERO ==================== -->
  <section class="hero grain relative isolate overflow-hidden border-b border-line">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap relative z-10 pt-12 pb-10 md:pt-24 md:pb-20">
      <div class="max-w-[36rem] lg:max-w-[42rem]">
        <p class="eyebrow">{accelerator.eyebrow}</p>
        <h1 class="display-xl mt-3">{accelerator.headline}</h1>
        <p class="mt-4 max-w-[30rem] text-[1.0625rem] text-muted md:text-[1.25rem]">{accelerator.subhead}</p>

        <div class="mt-7 md:hidden">
          <InfoBlocks items={info} />
          <a href="#apply" class="btn btn-ghost btn-block mt-5">Apply now</a>
          <a href="#curriculum" class="btn btn-ghost btn-block mt-2.5">See the fourteen days</a>
        </div>

        <div class="mt-9 hidden items-center gap-6 md:flex">
          <a href="#apply" class="btn btn-ghost shrink-0">Apply now</a>
          <InfoBlocks items={info} variant="row" />
        </div>

        <p class="mt-5 hidden text-[0.9375rem] text-muted md:block">
          ₹1,25,000. Application only — reviewed in 48 hours.
          <a href="#curriculum" class="ml-2 underline-offset-4 hover:text-fg hover:underline">See the fourteen days →</a>
        </p>

        <dl class="mt-10 flex gap-6 border-t border-line pt-6 md:mt-12 md:gap-10">
          {
            [
              { value: '14', label: 'Days, back-to-back' },
              { value: '70+', label: 'Hours of training' },
              { value: '7+', label: 'Applications built' },
            ].map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display block text-[1.75rem] font-bold leading-none md:text-[2.125rem]">{s.value}</span>
                  <span class="mt-0.5 block text-[0.8125rem] text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================== OUTCOMES ==================== -->
  <Section
    eyebrow="What you leave with"
    title="Seven things that run, and one that stays up."
    lead="Two weeks is enough to build a lot. It is only enough to operate one of them properly, so that is the one the capstone is for."
  >
    <div class="grid gap-4 md:grid-cols-3 md:gap-5">
      {
        outcomeCards.map((o) => (
          <article class="card flex flex-col p-5 md:p-7">
            <p class="num text-[2rem] text-accent">{o.metric}</p>
            <h3 class="heading-sm mt-2">{o.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{o.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== SPRINT TIMELINE ISLAND ==================== -->
  <Section
    rule
    id="curriculum"
    eyebrow="The fourteen days"
    title="Open a day to see what it asks of you."
    lead="Every block ends with something shippable. Tap one to see the focus, what you learn, and what you walk out with."
  >
    <SprintTimeline client:visible sprints={accelerator.sprints} />
  </Section>

  <!-- ==================== FEATURES ==================== -->
  <Section
    rule
    eyebrow="The stack you cover"
    title="From a first model call to an on-call rotation."
    lead="Each area exists because the capstone needs it, not because it looks good in a syllabus."
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-5">
      {
        accelerator.features.map((f) => (
          <article class="card p-5 md:p-7">
            <h3 class="heading-xs">{f.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== ADD-ONS ==================== -->
  <Section
    rule
    eyebrow="Included alongside"
    title="The work around the work."
    lead="Building the system is half of it. These cover the half that decides whether anyone pays for it."
  >
    <div class="grid gap-4 sm:grid-cols-2 md:gap-5">
      {
        addons.map((a) => (
          <article class="card p-5 md:p-7">
            <h3 class="heading-xs">{a.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{a.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== AUDIENCE ==================== -->
  <Section
    rule
    eyebrow="Who it's for"
    title="People who can actually clear two weeks."
    lead="This runs back-to-back at full-time intensity. Coding experience is assumed; the fourteen days are the real entry requirement."
  >
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <p class="label">You will be able to</p>
        <ul class="mt-4 space-y-3">
          {
            accelerator.outcomes.map((o) => (
              <li class="flex items-start gap-3 text-[0.9375rem] md:text-base">
                <svg viewBox="0 0 16 16" class="mt-1 size-4 shrink-0 text-accent" fill="none" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {o}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="label">This fits you if</p>
        <ul class="mt-4 space-y-3">
          {accelerator.audience.map((a) => <li class="card px-5 py-4 text-[0.9375rem]">{a}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- ==================== ADJACENT RUNGS ==================== -->
  <Section
    rule
    eyebrow="If the shape is wrong"
    title="Same material, a lighter or a longer commitment."
    lead="Fourteen evenings instead of fourteen full days, or six months of weekends if you cannot step away from work at all."
  >
    <div class="grid gap-4 md:grid-cols-2 md:gap-5">
      <LadderCard rung={before} />
      <LadderCard rung={after} />
    </div>
  </Section>

  <!-- ==================== FAQ ==================== -->
  <Section rule eyebrow="Before you apply" title="Straight answers.">
    <FAQ items={accelerator.faq} />
  </Section>

  <!-- ==================== APPLY ==================== -->
  <Section
    rule
    id="apply"
    eyebrow="Apply"
    title="Start your application."
    lead="Leave your email and the team comes back within 48 hours with fit, dates, and the payment path."
  >
    <div class="card max-w-2xl p-5 md:p-7">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-5">
        <span class="num text-[1.75rem] text-accent">₹1,25,000</span>
        <span class="text-[0.9375rem] text-muted">application only — nothing is charged here</span>
      </div>

      <form id="register-form" data-program={accelerator.slug} class="mt-5 flex flex-col gap-3 sm:flex-row">
        <label for="register-email" class="sr-only">Email address</label>
        <input
          id="register-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          class="w-full flex-1 rounded-md border border-line bg-bg px-4 py-3 text-[1rem] text-fg placeholder:text-faint focus:border-accent focus:outline-none"
        />
        <button type="submit" class="btn btn-ghost shrink-0">Apply now</button>
      </form>
      <p id="register-msg" role="status" class="mt-3 min-h-6 text-[0.9375rem] text-accent"></p>
      <p class="mt-1 text-[0.8125rem] text-muted">
        Applications are reviewed in 48 hours. Nothing is charged from this form.
      </p>
    </div>
  </Section>

  <Newsletter />

  <StickyCTA
    kind=\"apply\"
    label="14 days daily · Accelerator"
    price="₹1,25,000"
    ctaLabel="Apply now"
    ctaHref="#apply"
  />
</Base>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/gen/v2/accelerator-m.webp'), url('/gen/v2/accelerator.webp'), url('/gen/hero-accelerator.webp');
    background-position: 62% 38%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .hero-art {
      background-image: url('/gen/v2/accelerator.webp'), url('/gen/hero-accelerator.webp');
      background-position: right center;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.94) 0%, rgba(10, 10, 10, 0.78) 45%, rgba(10, 10, 10, 0.5) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.4) 0%, rgba(10, 10, 10, 0.6) 45%, rgba(10, 10, 10, 0.92) 78%, var(--color-bg) 100%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(10, 10, 10, 0.92) 38%, rgba(10, 10, 10, 0.25) 68%, rgba(10, 10, 10, 0) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.35) 0%, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 100%);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('register-form');
    if (!(form instanceof HTMLFormElement)) return;
    const msg = document.getElementById('register-msg');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, program: form.dataset.program }),
        });
        if (!res.ok) throw new Error('register failed');
        if (msg) msg.textContent = "Application started — we'll come back within 48 hours.";
        form.reset();
      } catch {
        if (msg) msg.textContent = 'Something went wrong. Please try again.';
      }
    });
  });
</script>

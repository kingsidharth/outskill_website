---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProgramCard from '../components/ProgramCard.astro';
import LogoWall from '../components/LogoWall.astro';
import CTA from '../components/CTA.astro';
import ProgramPicker from '../components/islands/ProgramPicker.tsx';
import { site, programs } from '../data/site';
---

<Base
  title="Outskill Engineering — AI Engineering Programs"
  description={site.hub.subhead}
  image="/gen/hero-hub.webp"
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background: linear-gradient(180deg, rgba(10,10,10,0.3) 0%, var(--bg) 100%), url('/gen/hero-hub.webp') center/cover no-repeat"
      aria-hidden="true"
    />
    <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-32">
      <h1 class="max-w-3xl text-4xl leading-tight sm:text-6xl">{site.hub.headline}</h1>
      <p class="mt-4 max-w-xl text-base text-muted sm:text-lg">{site.hub.subhead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/mastermind" class="btn-accent">Register free →</a>
        <a href="#programs" class="btn-ghost">Compare programs</a>
      </div>
    </div>
  </section>

  <!-- Program Picker -->
  <Section eyebrow="Find your fit" title="Not sure where to start?">
    <ProgramPicker client:idle questions={site.hub.picker} programs={programs} />
  </Section>

  <!-- Program Cards -->
  <Section id="programs" eyebrow="Our programs" title="Compare and choose your path." lead="Four programs, one mission: turn you into an AI engineer who ships.">
    <div class="grid gap-6 sm:grid-cols-2">
      {programs.map((p) => <ProgramCard program={p} />)}
    </div>
  </Section>

  <!-- Logo Wall -->
  <LogoWall />

  <!-- CTA -->
  <CTA eyebrow="Start today" title="Your next step is one click away." ctaLabel="Register free" ctaHref="/mastermind" />
</Base>
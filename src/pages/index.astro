---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import InfoBlocks from '../components/InfoBlocks.astro';
import LadderCard from '../components/LadderCard.astro';
import PathSplit from '../components/PathSplit.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Newsletter from '../components/Newsletter.astro';
import FAQ from '../components/FAQ.astro';
import StickyCTA from '../components/StickyCTA.astro';
import PathChooser from '../components/islands/PathChooser.tsx';
import NextSession from '../components/islands/NextSession.tsx';
import { hero, homeFaq, outcomes } from '../data/site';
import { ladder } from '../data/ladder';
import { workshops, nextWorkshopSession, formatIST, WORKSHOP_TIME } from '../data/workshops';

const nextSession = formatIST(nextWorkshopSession());
---

<Base
  title="Outskill — Learn AI engineering by shipping it"
  description="Free 90-minute workshops and a free live weekend. Pick your next step by time, cost, and what you walk away with."
  image="/gen/v2/home.webp"
  cta={{ label: 'Claim free seat', href: hero.cta.href }}
>
  <!-- ==================== HERO ==================== -->
  <section class="hero grain relative isolate overflow-hidden border-b border-line">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap relative z-10 pt-12 pb-10 md:pt-24 md:pb-20">
      <div class="max-w-[36rem] lg:max-w-[42rem]">
        <p class="eyebrow">Free · Live · This weekend</p>
        <h1 class="display-xl mt-3">{hero.headline}</h1>
        <p class="mt-4 max-w-[30rem] text-[1.0625rem] text-muted md:text-[1.25rem]">{hero.subhead}</p>

        <!-- Mobile: info blocks above a full-width button (reference order). -->
        <div class="mt-7 md:hidden">
          <InfoBlocks items={hero.info} />
          <a href={hero.cta.href} class="btn btn-accent btn-block mt-5">{hero.cta.label}</a>
          <a href={hero.secondary.href} class="btn btn-ghost btn-block mt-2.5">{hero.secondary.label}</a>
        </div>

        <!-- Desktop: button, vertical rule, info blocks alongside. -->
        <div class="mt-9 hidden items-center gap-6 md:flex">
          <a href={hero.cta.href} class="btn btn-accent shrink-0">{hero.cta.label}</a>
          <InfoBlocks items={hero.info} variant="row" />
        </div>

        <a href={hero.secondary.href} class="mt-5 hidden text-[0.9375rem] text-muted underline-offset-4 hover:text-fg hover:underline md:inline-block">
          {hero.secondary.label} →
        </a>

        <!-- Stats row -->
        <dl class="mt-10 flex gap-6 border-t border-line pt-6 md:mt-12 md:gap-10">
          {
            hero.stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display block text-[1.75rem] font-bold leading-none md:text-[2.125rem]">{s.value}</span>
                  <span class="mt-0.5 block text-[0.8125rem] text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================== TRUST ==================== -->
  <TrustStrip />

  <!-- ==================== VALUE LADDER ==================== -->
  <Section
    id="ladder"
    eyebrow="Pick by commitment"
    title="Start with the time you actually have."
    lead="Every step below leads with what it costs you in hours and rupees, and what you leave with. The name of the program is the least interesting part."
  >
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-5">
      {ladder.map((r) => <LadderCard rung={r} featured={r.price.current === 'Free'} />)}

      <aside class="card flex flex-col justify-center border-dashed p-5 md:p-7">
        <p class="heading-sm">Not sure how far to go?</p>
        <p class="mt-2 text-[0.9375rem] text-muted">
          Everyone starts at step 0 or 1. Both are free, and nothing above them is worth paying for until you
          have shipped something small.
        </p>
        <a href="#paths" class="btn btn-ghost btn-sm mt-5 self-start">Choose a path instead</a>
      </aside>
    </div>
  </Section>

  <!-- ==================== PATH SPLIT ==================== -->
  <Section
    id="paths"
    rule
    eyebrow="Choose your path"
    title="Two ways in. Pick the one that sounds like your week."
    lead="Same ideas, different starting point. You can switch later — plenty do."
  >
    <PathSplit />
    <div class="mt-6">
      <PathChooser client:visible />
    </div>
  </Section>

  <!-- ==================== WORKSHOPS ==================== -->
  <Section
    id="workshops"
    rule
    eyebrow="Step 0 · Free"
    title="90 minutes, in the tool you already use."
    lead="Same session, five flavours. You build one working thing while it runs."
  >
    <div class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between md:p-6">
      <div>
        <p class="label">Next session</p>
        <p class="mt-1 text-[1.25rem]">
          <NextSession client:visible fallback={nextSession} time={WORKSHOP_TIME} />
        </p>
      </div>
      <p class="text-[0.9375rem] text-muted sm:max-w-xs">
        Runs every other day. Free, live, and recorded — take the next one that fits.
      </p>
    </div>

    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        workshops.map((w) => (
          <li>
            <a href={w.href} class="card card-hover group flex h-full flex-col p-4 md:p-5">
              <div class="flex items-center justify-between gap-3">
                <h3 class="heading-xs">{w.tool}</h3>
                <span class="shrink-0 text-[0.8125rem] text-faint">
                  {w.audience.includes('coders') && !w.audience.includes('vibe-coders') ? 'For coders' : 'No code needed'}
                </span>
              </div>
              <p class="mt-2 text-[0.9375rem] leading-snug text-muted">{w.outcome}</p>
              <div class="flex-1" aria-hidden="true" />
              <span class="mt-4 inline-flex items-center gap-1.5 text-[0.875rem] font-semibold text-accent">
                Reserve a seat
                <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 8h11M9 3.5L13.5 8 9 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ==================== OUTCOMES ==================== -->
  <Section
    rule
    eyebrow="What you leave with"
    title="Every step ends in something that runs."
    lead="Not a certificate, not a notebook of slides. A thing you can open, show, and keep working on."
  >
    <div class="grid gap-4 md:grid-cols-3 md:gap-5">
      {
        outcomes.map((o) => (
          <article class="card flex flex-col p-5 md:p-7">
            <p class="num text-[2rem] text-accent">{o.metric}</p>
            <h3 class="heading-sm mt-2">{o.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{o.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== FAQ ==================== -->
  <Section rule eyebrow="Before you book" title="Straight answers.">
    <FAQ items={homeFaq} />
  </Section>

  <!-- ==================== NEWSLETTER ==================== -->
  <Newsletter />

  <StickyCTA
    label="2-Day Mastermind · this weekend"
    price="Free"
    listPrice="₹4,999"
    ctaLabel="Claim seat"
    ctaHref={hero.cta.href}
  />
</Base>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  /* Art layer: v2 first, V1 hero as a fallback underneath. A missing top
     layer is simply transparent, so the lower one shows through. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/gen/v2/home-m.webp'), url('/gen/v2/home.webp'), url('/gen/hero-hub.webp');
    background-position: 62% 38%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .hero-art {
      background-image: url('/gen/v2/home.webp'), url('/gen/hero-hub.webp');
      background-position: right center;
    }
  }

  /* Scrim: keeps AA contrast for the headline and the lime button over art. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.94) 0%, rgba(10, 10, 10, 0.72) 45%, rgba(10, 10, 10, 0.42) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.35) 0%, rgba(10, 10, 10, 0.55) 45%, rgba(10, 10, 10, 0.9) 78%, var(--color-bg) 100%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(10, 10, 10, 0.92) 38%, rgba(10, 10, 10, 0.25) 68%, rgba(10, 10, 10, 0) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.35) 0%, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 100%);
    }
  }
</style>

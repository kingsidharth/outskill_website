---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import InfoBlocks from '../components/InfoBlocks.astro';
import LadderCard from '../components/LadderCard.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { ladder } from '../data/ladder';
import ToolLogos from '../components/ToolLogos.astro';
import { workshops } from '../data/workshops';
import { hero as siteHero } from '../data/site';
import { mastermind } from '../data/mastermind';
import { codersCta, codersFaq, codersHero, codersLadder, codersOutcomes, codersWorkshops } from '../data/coders';

const rungs = ladder.filter((r) => r.audience.includes('coders'));
const coderWorkshops = workshops.filter((w) => w.audience.includes('coders'));
// The next Mastermind's facts, not a second copy of them.
const info = mastermind.stats;
---

<Base
  title="Outskill for coders — hand an agent a real ticket"
  description="Free 90-minute workshops in Claude Code, Codex, or Copilot, and a free live weekend. Pick your next step by time, cost, and what ships."
  image="/gen/v2/coders.webp"
  cta={{ label: 'Claim free seat', href: codersHero.cta.href }}
>
  <!-- ==================== HERO ==================== -->
  <section class="hero grain relative isolate overflow-hidden border-b border-line">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap relative z-10 pt-12 pb-10 md:pt-24 md:pb-20">
      <div class="max-w-[36rem] lg:max-w-[42rem]">
        <p class="eyebrow">{codersHero.eyebrow}</p>
        <h1 class="display-xl mt-3">{codersHero.headline}</h1>
        <p class="mt-4 max-w-[32rem] text-[1.0625rem] text-muted md:text-[1.25rem]">{codersHero.subhead}</p>

        <div class="mt-7 md:hidden">
          <InfoBlocks items={info} />
          <a href={codersHero.cta.href} class="btn btn-accent btn-block mt-5">{codersHero.cta.label}</a>
          <a href={codersHero.secondary.href} class="btn btn-ghost btn-block mt-2.5">{codersHero.secondary.label}</a>
        </div>

        <div class="mt-9 hidden items-center gap-6 md:flex">
          <a href={codersHero.cta.href} class="btn btn-accent shrink-0">{codersHero.cta.label}</a>
          <InfoBlocks items={info} variant="row" />
        </div>

        <a
          href={codersHero.secondary.href}
          class="mt-5 hidden text-[0.9375rem] text-muted underline-offset-4 hover:text-fg hover:underline md:inline-block"
        >
          {codersHero.secondary.label} →
        </a>

        <dl class="mt-10 flex gap-6 border-t border-line pt-6 md:mt-12 md:gap-10">
          {
            siteHero.stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display block text-[1.75rem] font-bold leading-none md:text-[2.125rem]">{s.value}</span>
                  <span class="mt-1 block text-[0.8125rem] text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================== LADDER ==================== -->
  <Section id="ladder" eyebrow={codersLadder.eyebrow} title={codersLadder.title} lead={codersLadder.lead}>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-5">
      {rungs.map((r) => <LadderCard rung={r} featured={r.price.current === 'Free'} />)}

      <aside class="card flex flex-col justify-center border-dashed p-5 md:p-7">
        <p class="heading-sm">Not sure how far to go?</p>
        <p class="mt-2 text-[0.9375rem] text-muted">
          Start at step 0 or 1. Both are free.
        </p>
        <a href="/mastermind" class="btn btn-ghost btn-sm mt-5 self-start">Start with the free weekend</a>
      </aside>
    </div>
  </Section>

  <!-- ==================== OUTCOMES ==================== -->
  <Section rule eyebrow={codersOutcomes.eyebrow} title={codersOutcomes.title} lead={codersOutcomes.lead}>
    <div class="grid gap-4 md:grid-cols-3 md:gap-5">
      {
        codersOutcomes.items.map((o) => (
          <article class="card flex flex-col p-5 md:p-7">
            <p class="num text-[2rem] text-accent">{o.metric}</p>
            <h3 class="heading-sm mt-2">{o.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{o.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== WORKSHOP STRIP ==================== -->
  <!-- Logos, not links: all three flavours book the same seat. -->
  <Section rule eyebrow={codersWorkshops.eyebrow} title={codersWorkshops.title} lead={codersWorkshops.lead}>
    <ToolLogos slugs={coderWorkshops.map((w) => w.slug)} label="Tools the 90 min Workshop runs in for coders" />
    <p class="mt-6 text-[0.9375rem] text-muted">
      Free, live, recorded. Every other day.
    </p>
    <a href="/workshops" class="btn btn-ghost mt-6">See the 90 min Workshop</a>
  </Section>

  <!-- ==================== FAQ ==================== -->
  <Section rule eyebrow="Before you book" title="Straight answers.">
    <FAQ items={codersFaq} />
  </Section>

  <!-- ==================== CLOSING CTA ==================== -->
  <section class="relative overflow-hidden border-y border-line bg-surface/40">
    <div class="wrap py-14 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">{codersCta.eyebrow}</p>
        <h2 class="display-lg mt-3">{codersCta.title}</h2>
        <p class="mt-4 max-w-xl text-[1.0625rem] text-muted md:text-[1.125rem]">
          Two days, twelve hours, live. Free with the coupon from a two-minute quiz.
        </p>
        <div class="mt-8">
          <a href={codersCta.ctaHref} class="btn btn-accent w-full sm:w-auto">{codersCta.ctaLabel}</a>
        </div>
        <div class="mt-8">
          <InfoBlocks items={info} />
        </div>
      </div>
    </div>
  </section>

  <Newsletter />

  <StickyCTA
    label="Weekend Mastermind"
    price="Free"
    listPrice="₹4,999"
    ctaLabel="Claim free seat"
    ctaHref={codersHero.cta.href}
  />
</Base>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/gen/v2/coders-m.webp'), url('/gen/v2/coders.webp'), url('/gen/hero-hub.webp');
    background-position: 62% 38%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .hero-art {
      background-image: url('/gen/v2/coders.webp'), url('/gen/hero-hub.webp');
      background-position: right center;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.96) 0%, rgba(10, 10, 10, 0.82) 45%, rgba(10, 10, 10, 0.58) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.4) 0%, rgba(10, 10, 10, 0.62) 45%, rgba(10, 10, 10, 0.92) 78%, var(--color-bg) 100%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(10, 10, 10, 0.92) 38%, rgba(10, 10, 10, 0.25) 68%, rgba(10, 10, 10, 0) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.35) 0%, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 100%);
    }
  }
</style>

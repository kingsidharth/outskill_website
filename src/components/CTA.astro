---
import InfoBlocks from './InfoBlocks.astro';
import type { InfoBlock } from '../data/types';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  info?: InfoBlock[];
}

const {
  eyebrow,
  title = 'Start with the free weekend.',
  body,
  ctaLabel = 'Claim your free seat',
  ctaHref = '/mastermind#register',
  secondaryLabel,
  secondaryHref,
  info,
} = Astro.props;
---

<section class="relative overflow-hidden border-y border-line bg-surface/40">
  <div class="wrap py-14 md:py-24">
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class:list={['display-lg', eyebrow && 'mt-3']}>{title}</h2>
      {body && <p class="mt-4 max-w-xl text-[1.0625rem] text-muted md:text-[1.125rem]">{body}</p>}

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={ctaHref} class="btn btn-accent btn-block sm:w-auto">{ctaLabel}</a>
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="btn btn-ghost btn-block sm:w-auto">{secondaryLabel}</a>
        )}
      </div>

      {info && info.length > 0 && <div class="mt-8"><InfoBlocks items={info} /></div>}
    </div>
  </div>
</section>

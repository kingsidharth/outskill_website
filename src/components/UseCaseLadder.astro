---
/**
 * The 1-5 use-case ladder on a workshop landing page.
 *
 * Steps 1-3 are described in full. Step 4 is a teaser — title and one line.
 * Step 5 is never described here: the data carries no text for it and this
 * component renders a fixed locked line instead. The content of step 5 exists
 * only in the room.
 *
 * Type as composition: the numeral is a display element, not a paragraph.
 */
import type { LadderStep } from '../data/workshops';

interface Props {
  steps: LadderStep[];
}

const { steps } = Astro.props;
---

<ol class="border-t border-line">
  {
    steps.map((s) => {
      if (s.hidden) {
        return (
          <li class="flex gap-5 border-b border-line py-7 md:gap-8 md:py-9">
            <span
              class="display-lg w-[2.5rem] shrink-0 text-line-strong md:w-[4rem]"
              aria-hidden="true"
            >
              {s.n}
            </span>
            <div class="min-w-0 flex-1">
              <p class="label">Step {s.n}</p>
              <h3 class="heading-sm mt-1.5 text-faint">Step 5 — we keep this one for the room</h3>
              <div class="mt-3 max-w-2xl rounded-lg border border-dashed border-line-strong px-4 py-3">
                <span class="block h-2.5 w-4/5 rounded-full bg-line" aria-hidden="true"></span>
                <span class="mt-2 block h-2.5 w-3/5 rounded-full bg-line" aria-hidden="true"></span>
                <span class="sr-only">The fifth step is not published. It runs live in the session.</span>
              </div>
            </div>
          </li>
        );
      }

      return (
        <li class="flex gap-5 border-b border-line py-7 md:gap-8 md:py-9">
          <span
            class:list={[
              'display-lg w-[2.5rem] shrink-0 md:w-[4rem]',
              s.teaser ? 'text-line-strong' : 'text-accent',
            ]}
            aria-hidden="true"
          >
            {s.n}
          </span>
          <div class="min-w-0 flex-1">
            <p class="label">
              Step {s.n}
              {s.teaser && <span class="text-accent"> · teaser</span>}
            </p>
            <h3 class="display-md mt-1.5">{s.title}</h3>
            <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-muted">{s.blurb}</p>
          </div>
        </li>
      );
    })
  }
</ol>

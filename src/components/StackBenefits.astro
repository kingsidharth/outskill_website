---
/**
 * The stack written as benefits, not a logo wall (BRIEF-V3 §4).
 * Generic {title, body} cards — reusable on any program page.
 */
interface Item { title: string; body: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-5">
  {
    items.map((item) => (
      <article class="card p-5 md:p-7">
        <h3 class="heading-sm">{item.title}</h3>
        <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
      </article>
    ))
  }
</div>

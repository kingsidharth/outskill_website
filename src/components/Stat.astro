---
import type { Stat } from '../data/types';

interface Props {
  stat?: Stat;
  value?: string;
  label?: string;
  /** 'lg' for hero stat rows, 'sm' inside cards. */
  size?: 'lg' | 'sm';
  class?: string;
}

const { stat, value, label, size = 'lg', class: className } = Astro.props;
const v = stat?.value ?? value;
const l = stat?.label ?? label;
---

{
  v && l && (
    <div class={className}>
      <p class:list={['num text-fg', size === 'lg' ? 'text-[1.75rem] md:text-[2rem]' : 'text-[1.25rem]']}>{v}</p>
      <p class="mt-1 text-[0.8125rem] text-muted">{l}</p>
    </div>
  )
}

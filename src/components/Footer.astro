---
import { site } from '../data/site';
import { workshops } from '../data/workshops';

const { name, tagline, footer } = site;
const year = new Date().getFullYear();

/**
 * V4 §2: the per-tool landing pages are linked from here and nowhere else.
 * Every other surface points at `/workshops`, which books the same seat.
 */
const byTool = workshops.map((w) => ({ label: w.tool, href: w.path }));
---

<footer class="border-t border-line">
  <div class="wrap py-12 md:py-16">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-7">
      <div class="sm:col-span-2 md:col-span-3 lg:col-span-2">
        <a href="/" class="inline-flex items-baseline gap-1 text-[1.125rem] font-bold">
          {name}<span class="inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        </a>
        <p class="mt-3 max-w-xs text-[0.9375rem] text-muted">{tagline}</p>
        <a href="https://outskill.com/#newsletter" class="btn btn-ghost btn-sm mt-5">Get the newsletter</a>
      </div>

      <nav aria-label="Workshops by tool">
        <h2 class="label">Workshops by tool</h2>
        <ul class="mt-3.5 space-y-2.5">
          {
            byTool.map((link) => (
              <li>
                <a href={link.href} class="text-[0.9375rem] text-fg/80 transition-colors hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        footer.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="label">{col.heading}</h2>
            <ul class="mt-3.5 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[0.9375rem] text-fg/80 transition-colors hover:text-fg">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[0.875rem] text-muted">© {year} Sisinty Pvt. Ltd.</p>
      <p class="text-[0.875rem] text-faint">Live cohorts run on India Standard Time.</p>
    </div>
  </div>
</footer>

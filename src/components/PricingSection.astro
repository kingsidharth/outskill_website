---
/**
 * The ONLY place a rupee amount appears for a program (BRIEF-V3 §2).
 *
 * V4 §4: one calm card. Eyebrow, one big display amount with the struck list
 * price small above it, a tight two-column list of what is included, one
 * button, one note. No accent boxes, no bullet squares. Designed at 390px
 * first — the card is single-column there and the list stacks.
 *
 * Props are unchanged from V3 so callers do not move.
 */
import type { PricingBlock } from '../data/types';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  pricing: PricingBlock;
  programLabel: string;
}

const { id = 'pricing', eyebrow = 'Pricing', title = 'One number. Everything included.', pricing, programLabel } = Astro.props;
const btn = pricing.kind === 'apply' ? 'btn btn-ghost' : 'btn btn-accent';
---

<section id={id} class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <p class="label text-accent">{eyebrow}</p>
    <h2 class="display-lg mt-2 max-w-2xl">{title}</h2>

    <div class="card mt-8 max-w-2xl p-5 sm:p-7 md:mt-10 md:p-9">
      <p class="label">{programLabel}</p>

      <p class="mt-5">
        {pricing.list && <span class="block text-[0.9375rem] text-faint line-through">{pricing.list}</span>}
        <span class="display-lg block">{pricing.current}</span>
      </p>

      <ul class="mt-7 grid border-t border-line sm:grid-cols-2 sm:gap-x-10">
        {
          pricing.includes.map((item) => (
            <li class="border-b border-line py-2.5 text-[0.9375rem] leading-snug text-muted">{item}</li>
          ))
        }
      </ul>

      <a href={pricing.ctaHref} class={`${btn} btn-block mt-7 sm:w-auto`}>{pricing.ctaLabel}</a>
      {pricing.note && <p class="mt-3 text-[0.875rem] leading-snug text-muted">{pricing.note}</p>}
    </div>
  </div>
</section>

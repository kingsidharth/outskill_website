---
/**
 * Who is in the room, set as big type rather than prose (BRIEF-V3 §4).
 * `figures` render as display numerals; `roles` as a divided list.
 */
interface Figure { value: string; label: string }
interface Props { figures: Figure[]; roles: string[] }
const { figures, roles } = Astro.props;
---

<div>
  <dl class="grid gap-8 border-b border-line pb-10 sm:grid-cols-2 md:gap-12">
    {
      figures.map((f) => (
        <div>
          <dt class="sr-only">{f.label}</dt>
          <dd>
            <span class="display-xl block text-accent">{f.value}</span>
            <span class="mt-3 block text-[1rem] text-muted">{f.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <ul class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-3 md:gap-x-6">
    {
      roles.map((r, i) => (
        <li class="flex items-baseline gap-4 md:gap-6">
          <span class:list={['display-md', i === roles.length - 1 ? 'text-accent' : 'text-fg']}>{r}</span>
          {i < roles.length - 1 && <span class="text-faint" aria-hidden="true">·</span>}
        </li>
      ))
    }
  </ul>
</div>

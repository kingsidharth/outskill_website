---
/**
 * No API was invented for this. The form is a plain GET to outskill.com's
 * existing newsletter surface, carrying the address the visitor typed so the
 * real signup form can prefill it. Swap `action`/`method` for a POST endpoint
 * the day one exists — the markup does not need to change.
 */
---

<section id="newsletter" class="border-t border-line bg-paper text-paper-ink">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-8 md:grid-cols-2 md:items-end md:gap-16">
      <div>
        <p class="label text-paper-muted">Every other week</p>
        <h2 class="display-lg mt-2">What actually shipped, and what broke.</h2>
        <p class="mt-4 max-w-lg text-[1.0625rem] text-paper-muted">
          One short letter on AI engineering in practice: the agent setups that held up in production, the ones
          that did not, and the next free session date. No launch noise.
        </p>
      </div>

      <form
        action="/api/register"
        method="post"
        class="w-full"
        aria-label="Subscribe to the newsletter"
        data-newsletter
      >
        <input type="hidden" name="program" value="newsletter" />
        <label for="nl-email" class="label text-paper-muted">Email address</label>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <input
            id="nl-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="w-full rounded-md border border-paper-line bg-white px-4 py-3 text-[1rem] text-paper-ink placeholder:text-paper-muted/70 focus:border-paper-ink focus:outline-none"
          />
          <button type="submit" class="btn shrink-0 bg-paper-ink text-paper hover:bg-black">Subscribe</button>
        </div>
        <p class="mt-3 text-[0.8125rem] text-paper-muted" data-newsletter-status aria-live="polite">
          Unsubscribe in one click, any time.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  function bindNewsletter() {
    document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
        const email = (form.querySelector<HTMLInputElement>('input[type=email]')?.value ?? '').trim();
        const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (btn) btn.disabled = true;
        try {
          const res = await fetch('/api/register', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, program: 'newsletter' }),
          });
          if (!res.ok) throw new Error(String(res.status));
          if (status) status.textContent = "You're on the list. The next letter lands within the week.";
          form.reset();
        } catch {
          if (status) status.textContent = 'That did not go through. Check the address and try again.';
          if (btn) btn.disabled = false;
        }
      });
    });
  }
  bindNewsletter();
  document.addEventListener('astro:page-load', bindNewsletter);
</script>

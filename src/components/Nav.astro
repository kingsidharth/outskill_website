---
import { site } from '../data/site';
import { ladder } from '../data/ladder';
import type { NavLink } from '../data/types';

interface Props {
  cta?: NavLink;
}

const { cta } = Astro.props;
const primary = cta ?? site.primaryCta;
const { name } = site;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const flat = site.nav.filter((l) => l.label !== 'Explore Courses');
const isActive = (href: string) => current === href;
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="wrap flex h-14 items-center justify-between gap-4 md:h-16" aria-label="Main">
    <a href="/" class="flex shrink-0 items-baseline gap-1 text-[1.125rem] font-bold">
      {name}<span class="inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-7 md:flex">
      {
        flat.map((link) => (
          <a
            href={link.href}
            class:list={['text-[0.9375rem]', isActive(link.href) ? 'text-fg' : 'text-muted hover:text-fg']}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <div class="relative" data-explore>
        <button
          type="button"
          class="flex items-center gap-1.5 text-[0.9375rem] text-muted hover:text-fg"
          aria-expanded="false"
          aria-controls="explore-menu"
          data-explore-toggle
        >
          Explore Courses
          <svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <div
          id="explore-menu"
          hidden
          class="absolute right-0 top-full z-50 mt-3 w-[30rem] overflow-hidden rounded-lg border border-line bg-surface shadow-2xl"
        >
          <p class="border-b border-line px-4 py-3 label">By time, cost, and outcome</p>
          <ul>
            {
              ladder.map((r) => (
                <li class="border-b border-line last:border-0">
                  <a href={r.href} class="block px-4 py-3.5 hover:bg-surface-2">
                    <div class="flex items-baseline justify-between gap-4">
                      <span class="font-display text-[1.125rem] leading-none">{r.time}</span>
                      <span class="shrink-0 text-[0.9375rem] font-semibold text-accent">
                        {r.price.list && <span class="mr-1.5 font-normal text-faint line-through">{r.price.list}</span>}
                        {r.price.current}
                      </span>
                    </div>
                    <p class="mt-1.5 text-[0.875rem] leading-snug text-muted">{r.outcome}</p>
                    <p class="mt-1 text-[0.8125rem] text-faint">{r.name}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <a href={primary.href} class="btn btn-accent btn-sm">{primary.label}</a>
    </div>

    <!-- Mobile -->
    <div class="flex items-center gap-2 md:hidden">
      <a href={primary.href} class="btn btn-accent btn-sm text-[0.8125rem]">{primary.label}</a>
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-md border border-line text-fg"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Menu"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path class="icon-open" d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          <path class="icon-close hidden" d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-menu" hidden class="max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t border-line bg-bg md:hidden">
    <p class="wrap pt-4 label">By time, cost, and outcome</p>
    <ul class="wrap mt-2 pb-2">
      {
        ladder.map((r) => (
          <li class="border-b border-line last:border-0">
            <a href={r.href} class="block py-3.5">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-display text-[1.25rem] leading-none">{r.time}</span>
                <span class="shrink-0 text-[0.9375rem] font-semibold text-accent">
                  {r.price.list && <span class="mr-1.5 font-normal text-faint line-through">{r.price.list}</span>}
                  {r.price.current}
                </span>
              </div>
              <p class="mt-1.5 text-[0.875rem] leading-snug text-muted">{r.outcome}</p>
              <p class="mt-1 text-[0.8125rem] text-faint">{r.name}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="wrap flex flex-col gap-2.5 border-t border-line py-4">
      {flat.map((link) => <a href={link.href} class="py-1.5 text-[0.9375rem] text-muted">{link.label}</a>)}
      <a href={primary.href} class="btn btn-accent btn-block mt-1">{primary.label}</a>
    </div>
  </div>
</header>

<script>
  function setupNav() {
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-menu');
    if (btn && menu && !btn.dataset.navBound) {
      btn.dataset.navBound = '1';
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        menu.toggleAttribute('hidden', !open);
        btn.querySelector('.icon-open')?.classList.toggle('hidden', open);
        btn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
    }

    const exp = document.querySelector('[data-explore]');
    const expBtn = exp?.querySelector<HTMLButtonElement>('[data-explore-toggle]');
    const expMenu = document.getElementById('explore-menu');
    if (exp && expBtn && expMenu && !expBtn.dataset.navBound) {
      expBtn.dataset.navBound = '1';
      const setOpen = (open: boolean) => {
        expBtn.setAttribute('aria-expanded', String(open));
        expMenu.toggleAttribute('hidden', !open);
      };
      expBtn.addEventListener('click', () => setOpen(expBtn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('click', (e) => {
        if (!exp.contains(e.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') setOpen(false);
      });
    }
  }

  document.addEventListener('astro:page-load', setupNav);
  if (document.readyState !== 'loading') setupNav();
  else document.addEventListener('DOMContentLoaded', setupNav);
</script>

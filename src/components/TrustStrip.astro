---
import { trust } from '../data/site';

// Resolved at build time; safe under prerender + SSR.
// These assets ship as white cards with the mark inside, so they are rendered
// as light chips rather than knocked out to white silhouettes.
const modules = import.meta.glob('/public/ref/{cs,co}*.svg', { eager: true, query: '?url', import: 'default' });
const logos: string[] = Object.keys(modules)
  .map((k) => k.split('/').pop() as string)
  .sort();
---

<section aria-label="Tools and backing" class="border-b border-line bg-bg-deep">
  <div class="wrap py-10 md:py-14">
    <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_20rem] md:gap-16">
      <div>
        <p class="label">{trust.logosNote}</p>
        {
          logos.length > 0 && (
            <ul class="mt-4 flex flex-wrap items-center gap-2.5">
              {logos.map((file, i) => (
                <li>
                  <img
                    src={`/ref/${file}`}
                    alt={`Tool logo ${i + 1}`}
                    width="126"
                    height="78"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-auto rounded-sm opacity-90 md:h-11"
                  />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="border-t border-line pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-16">
        <p class="label">Backing</p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{trust.line}</p>
      </div>
    </div>
  </div>
</section>

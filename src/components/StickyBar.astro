---
/**
 * Deprecated: kept so the not-yet-restyled program pages keep building.
 * New pages should use StickyCTA.astro directly with explicit props.
 */
import StickyCTA from './StickyCTA.astro';
import type { Program } from '../data/types';

interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<StickyCTA
  label={program.name}
  price={program.price.current}
  listPrice={program.price.original}
  ctaLabel={program.ctaLabel}
  ctaHref={program.ctaHref}
/>
